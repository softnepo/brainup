<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BrainUp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/main_color</item>
        <item name="android:windowBackground">@color/main_color</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="android:statusBarColor">#F24074</item>
        <item name="android:windowBackground">#F24074</item>
        <item name="windowSplashScreenBackground">#F24074 </item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="windowSplashScreenAnimationDuration">450</item>
        <item name="postSplashScreenTheme">@style/Theme.BrainUp</item>
    </style>
</resources>